<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Interconnect</AssemblyName>
    <RootNamespace>Midterm</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AllArchStub\**" />
    <Compile Remove="Audio\**" />
    <Compile Remove="obj\**;bin\**;InterconnectAndroid\**;publish\**" />
    <EmbeddedResource Remove="AllArchStub\**" />
    <EmbeddedResource Remove="Audio\**" />
    <None Remove="AllArchStub\**" />
    <None Remove="Audio\**" />
  </ItemGroup>

</Project>
